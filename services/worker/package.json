{
  "name": "weather-worker",
  "version": "1.0.0",
  "description": "Worker Service for Processing Weather Data Jobs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrations/migrate.ts",
    "process-pending": "tsx src/process-pending-jobs.ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "weather",
    "worker",
    "queue"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bull": "^4.12.0",
    "dotenv": "^16.6.1",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/socket.io": "^3.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
